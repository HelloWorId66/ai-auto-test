# 复制为 config/local/dev.yaml 后填写。该目录不入库。
# 测试环境在内网，口令可以直接写在这里；也可以把 password 换成 password_env: 环境变量名。
project: {project}
env_name: dev
product_version: ""                       # 被测产品版本，换版本必须改，否则会沿用旧标定
locale: zh-CN                             # 界面语言，菜单、按钮文字随语言变化
base_url: http://HOST:PORT/xxx/home.html
accounts:
  maker:   {username: "", password: ""}   # 经办/制单
  checker: {username: "", password: ""}   # 审核/复核
env_params:
  forms: {}                               # 表单ID: {menu: [一级菜单, 二级菜单, 三级菜单]}，路径由智能体从测试库查出
  ui_text:
    home_tab: "首页"
